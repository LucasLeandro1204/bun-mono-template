{
  "name": "bun-mono-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready Bun monorepo template with TypeScript references and workspace packages.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "bun run --workspaces build",
    "changeset": "bun ./node_modules/@changesets/cli/bin.js",
    "changeset:status": "bun ./node_modules/@changesets/cli/bin.js status --verbose",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build",
    "clean": "bun run scripts/clean.ts",
    "clean:dry-run": "bun run scripts/clean.ts --dry-run",
    "deps:outdated": "bun outdated",
    "dev": "bun run --filter @bun-mono-template/app dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "start": "bun run --filter @bun-mono-template/app start",
    "test": "bun test --path-ignore-patterns '**/dist/**'",
    "test:coverage": "bun test --coverage --path-ignore-patterns '**/dist/**'",
    "typecheck": "bun x tsc -p tsconfig.typecheck.json --noEmit && bun x tsc -p packages/shared/test/tsconfig.json --noEmit && bun x tsc -p packages/app/test/tsconfig.json --noEmit",
    "version-packages": "bun ./node_modules/@changesets/cli/bin.js version"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "catalog:",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.58.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
